# Server-only Appwrite contract (design D4) — copy to .env.local and fill in.
# Zero NEXT_PUBLIC_* keys: the browser never talks to Appwrite.
APPWRITE_ENDPOINT=https://your-appwrite-endpoint/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-server-api-key
APPWRITE_DATABASE_ID=your-database-id
APPWRITE_TASKS_COLLECTION_ID=your-tasks-collection-id
APPWRITE_ADMINS_TEAM_ID=your-admins-team-id
# Workaround (verified on Node 26): node-appwrite's createAgent() dispatcher is incompatible with the runtime's fetch — API calls fail with "fetch failed / invalid onError method".
FORCE_NODE_FETCH=1

# Reminders / Telegram (design "Env Contract") — ALL OPTIONAL and server-only.
# Absence disables reminders and the app still boots (spec reminder-delivery →
# "Disabled or unconfigured reminders"). Never prefix any of these NEXT_PUBLIC_*.
# Gate = the three TELEGRAM_* keys present AND REMINDERS_ENABLED !== 'false'.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_SECRET=
# Master switch: set to false for instant rollback (loops stop, app unaffected).
REMINDERS_ENABLED=true
# Reminder poll cadence in seconds (default 60; invalid values fall back to 60).
REMINDERS_POLL_SECONDS=60
# Origin the bot loop self-POSTs the /start token to (single container, loopback).
TELEGRAM_CALLBACK_ORIGIN=http://127.0.0.1:3000

