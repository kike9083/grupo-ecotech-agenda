# Server-only Appwrite contract (design D4) — copy to .env.local and fill in.
# Zero NEXT_PUBLIC_* keys: the browser never talks to Appwrite.
APPWRITE_ENDPOINT=https://your-appwrite-endpoint/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-server-api-key
APPWRITE_DATABASE_ID=your-database-id
APPWRITE_TASKS_COLLECTION_ID=your-tasks-collection-id
APPWRITE_ADMINS_TEAM_ID=your-admins-team-id
